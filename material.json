{% comment %}
  GitHub Pages genera este archivo al publicar la página: es la lista de todo
  lo que hay en la carpeta material/. La sección "Material" de index.html lo lee.
{% endcomment %}{% assign archivos = site.static_files | where_exp: "f", "f.path contains '/material/'" %}{
  "version": "{{ site.time | date: '%s' }}",
  "files": [{% for f in archivos %}
    {{ f.path | jsonify }}{% unless forloop.last %},{% endunless %}{% endfor %}
  ]
}
